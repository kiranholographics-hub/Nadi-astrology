# Copy this file to .env and fill it in. Never upload .env to GitHub.
NODE_ENV=production
PORT=5000

# MongoDB Atlas connection string (Atlas → Connect → Drivers). Database name at the end: /ptrs
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ptrs?retryWrites=true&w=majority

# Live website address — used in sitemap.xml and robots.txt (no slash at the end)
SITE_URL=https://nadiastrologerindia.com

# Only needed if the React site is hosted on a DIFFERENT domain than this server (comma-separated).
# Leave empty when this server also serves the website (normal setup).
CLIENT_ORIGIN=

# Thumb impressions / floor plans (private, never served publicly). Relative to the server folder.
PRIVATE_UPLOAD_DIR=private_uploads

# Admin panel (/admin)
# Long random secret for login cookies (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=
# First admin login — created automatically on first start if no admin exists.
# After the first start you can delete ADMIN_PASSWORD from this file.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Yantra photos uploaded from the admin (public). Relative to the server folder.
PUBLIC_UPLOAD_DIR=uploads

# Number of proxies in front of the app (Nginx / Hostinger / Render = 1)
TRUST_PROXY=1

# Next phase — payments & alerts
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
WHATSAPP_ALERT_NUMBER=
